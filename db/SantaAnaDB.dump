ALTER TABLE public.formularios_formularios_index_version OWNER TO santa_ana;

--
-- Name: formularios_fuente_datos; Type: TABLE; Schema: public; Owner: santa_ana
--

CREATE TABLE public.formularios_fuente_datos (
    id uuid NOT NULL,
    nombre character varying(200) NOT NULL,
    descripcion text NOT NULL,
    archivo_nombre character varying(255),
    blob_name character varying(500),
    blob_url character varying(1000),
    tipo_archivo character varying(10),
    columnas jsonb NOT NULL,
    preview_data jsonb NOT NULL,
    fecha_subida timestamp with time zone NOT NULL,
    activo boolean NOT NULL,
    creado_por_id character varying(50),
    tipo_fuente character varying(20) NOT NULL,
    consulta_sql_id uuid
);


ALTER TABLE public.formularios_fuente_datos OWNER TO santa_ana;

--
-- Name: formularios_fuente_datos_valor; Type: TABLE; Schema: public; Owner: santa_ana
--

CREATE TABLE public.formularios_fuente_datos_valor (
