--
-- Name: fn_row_log(); Type: FUNCTION; Schema: audit; Owner: santa_ana
--

CREATE FUNCTION audit.fn_row_log() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_pk jsonb;
BEGIN
  -- Para formularios_campo_grupo la PK es "id", pero además dejamos id_grupo/id_campo
  IF TG_TABLE_NAME = 'formularios_campo_grupo' THEN
    IF TG_OP = 'INSERT' THEN
      v_pk := jsonb_build_object(
        'id', NEW.id,
        'id_grupo', NEW.id_grupo,
        'id_campo', NEW.id_campo
      );
      INSERT INTO audit.log (action, table_schema, table_name, pk, row_new, client_addr)
      VALUES ('INSERT', TG_TABLE_SCHEMA, TG_TABLE_NAME, v_pk, to_jsonb(NEW), inet_client_addr());
      RETURN NEW;

    ELSIF TG_OP = 'UPDATE' THEN
      v_pk := jsonb_build_object(
        'id', COALESCE(NEW.id, OLD.id),
        'id_grupo', COALESCE(NEW.id_grupo, OLD.id_grupo),
        'id_campo', COALESCE(NEW.id_campo, OLD.id_campo)
      );
      INSERT INTO audit.log (action, table_schema, table_name, pk, row_old, row_new, client_addr)
      VALUES ('UPDATE', TG_TABLE_SCHEMA, TG_TABLE_NAME, v_pk, to_jsonb(OLD), to_jsonb(NEW), inet_client_addr());
      RETURN NEW;

    ELSIF TG_OP = 'DELETE' THEN
      v_pk := jsonb_build_object(
        'id', OLD.id,
        'id_grupo', OLD.id_grupo,
        'id_campo', OLD.id_campo
      );
      INSERT INTO audit.log (action, table_schema, table_name, pk, row_old, client_addr)
      VALUES ('DELETE', TG_TABLE_SCHEMA, TG_TABLE_NAME, v_pk, to_jsonb(OLD), inet_client_addr());
      RETURN OLD;
    END IF;
  ELSE
    -- fallback genérico por si copias la función a otras tablas
    IF TG_OP = 'INSERT' THEN
      INSERT INTO audit.log (action, table_schema, table_name, row_new, client_addr)
      VALUES ('INSERT', TG_TABLE_SCHEMA, TG_TABLE_NAME, to_jsonb(NEW), inet_client_addr());
      RETURN NEW;
    ELSIF TG_OP = 'UPDATE' THEN
      INSERT INTO audit.log (action, table_schema, table_name, row_old, row_new, client_addr)
      VALUES ('UPDATE', TG_TABLE_SCHEMA, TG_TABLE_NAME, to_jsonb(OLD), to_jsonb(NEW), inet_client_addr());
      RETURN NEW;
    ELSIF TG_OP = 'DELETE' THEN
      INSERT INTO audit.log (action, table_schema, table_name, row_old, client_addr)
      VALUES ('DELETE', TG_TABLE_SCHEMA, TG_TABLE_NAME, to_jsonb(OLD), inet_client_addr());
      RETURN OLD;
    END IF;
  END IF;

  RETURN NULL;
END;
$$;


