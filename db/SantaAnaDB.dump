CREATE TABLE public.formularios_formulario (
    id uuid NOT NULL,
    nombre character varying(100) NOT NULL,
    descripcion text NOT NULL,
    permitir_fotos boolean NOT NULL,
    permitir_gps boolean NOT NULL,
    disponible_desde_fecha date NOT NULL,
    disponible_hasta_fecha date NOT NULL,
    estado character varying(20) NOT NULL,
    forma_envio character varying(30) NOT NULL,
    es_publico boolean NOT NULL,
    auto_envio boolean NOT NULL,
    categoria_id uuid,
    periodicidad integer
);


ALTER TABLE public.formularios_formulario OWNER TO santa_ana;

--
-- Name: formularios_formularioindexversion; Type: TABLE; Schema: public; Owner: santa_ana
--

CREATE TABLE public.formularios_formularioindexversion (
