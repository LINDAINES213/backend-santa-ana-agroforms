-- Name: fn_truncate_log(); Type: FUNCTION; Schema: audit; Owner: santa_ana
--

CREATE FUNCTION audit.fn_truncate_log() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  INSERT INTO audit.log (action, table_schema, table_name, client_addr)
  VALUES ('TRUNCATE', TG_TABLE_SCHEMA, TG_TABLE_NAME, inet_client_addr());
  RETURN NULL;
END;
$$;


