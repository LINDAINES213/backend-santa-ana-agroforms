    fecha_creacion timestamp with time zone NOT NULL
);


ALTER TABLE public.formularios_formularioindexversion OWNER TO santa_ana;

--
-- Name: formularios_formularios_index_version; Type: TABLE; Schema: public; Owner: santa_ana
--

