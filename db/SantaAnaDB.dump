--
-- Name: purge_forms_of_user(text, boolean); Type: PROCEDURE; Schema: public; Owner: santa_ana
--

CREATE PROCEDURE public.purge_forms_of_user(IN p_user text, IN p_force_shared boolean DEFAULT false)
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_deleted_entries          BIGINT := 0;
  v_deleted_assocs           BIGINT := 0;
  v_deleted_piv              BIGINT := 0;  -- pagina_index_version
  v_deleted_fiv              BIGINT := 0;  -- formularios_formularios_index_version
  v_deleted_forms            BIGINT := 0;
  v_deleted_versions         BIGINT := 0;  -- formularioindexversion
  v_deleted_pc               BIGINT := 0;  -- pagina_campo (huérfanos)
  v_deleted_pv               BIGINT := 0;  -- pagina_version (huérfanos)
  v_deleted_pages            BIGINT := 0;  -- pagina (huérfanas)
  v_deleted_fdv              BIGINT := 0;  -- fuente_datos_valor (de campos huérfanos)
  v_deleted_groups           BIGINT := 0;  -- grupos huérfanos
  v_deleted_campos           BIGINT := 0;  -- campos huérfanos
BEGIN
  -- Asegura chequeo de FKs al final de la transacción
  SET CONSTRAINTS ALL DEFERRED;

  -- 1) Formularios objetivo:
  --    - Si p_force_shared = false: formularios asignados SOLO a p_user (exclusivos).
  --    - Si p_force_shared = true : formularios asignados a p_user (aunque haya otros).
  CREATE TEMP TABLE _del_forms (form_id UUID) ON COMMIT DROP;

  IF NOT p_force_shared THEN
    INSERT INTO _del_forms (form_id)
    SELECT f.id
    FROM formularios_formulario f
    WHERE EXISTS (
            SELECT 1
            FROM formularios_user_formulario uf
            WHERE uf.id_formulario_id = f.id
              AND uf.id_usuario_id    = p_user
          )
      AND NOT EXISTS (
            SELECT 1
            FROM formularios_user_formulario uf2
            WHERE uf2.id_formulario_id = f.id
              AND uf2.id_usuario_id   <> p_user
          );
  ELSE
    INSERT INTO _del_forms (form_id)
    SELECT DISTINCT f.id
    FROM formularios_formulario f
    JOIN formularios_user_formulario uf
      ON uf.id_formulario_id = f.id
    WHERE uf.id_usuario_id = p_user;
  END IF;

  -- Nada que borrar -> salir
  IF NOT EXISTS (SELECT 1 FROM _del_forms) THEN
    RAISE NOTICE '[purge_forms_of_user] No hay formularios para el usuario % (force_shared=%)', p_user, p_force_shared;
    RETURN;
  END IF;

  -- 2) Versiones de esos formularios
  CREATE TEMP TABLE _del_versions (id_index_version UUID) ON COMMIT DROP;
  INSERT INTO _del_versions (id_index_version)
  SELECT fiv.id_index_version
  FROM formularios_formularios_index_version fiv
  WHERE fiv.id_formulario IN (SELECT form_id FROM _del_forms);

  -- 3) Entradas (submissions) de esos formularios
  DELETE FROM formularios_entry e
  WHERE e.form_id IN (SELECT form_id FROM _del_forms);
  GET DIAGNOSTICS v_deleted_entries = ROW_COUNT;

  -- 4) Desasignar formularios (para todos los usuarios)
  DELETE FROM formularios_user_formulario uf
  WHERE uf.id_formulario_id IN (SELECT form_id FROM _del_forms);
  GET DIAGNOSTICS v_deleted_assocs = ROW_COUNT;

  -- 5) Romper vínculo versión<->página (solo de las versiones objetivo)
  DELETE FROM formularios_pagina_index_version piv
  WHERE piv.id_index_version IN (SELECT id_index_version FROM _del_versions);
  GET DIAGNOSTICS v_deleted_piv = ROW_COUNT;

  -- 6) Romper vínculo formulario<->versión y después borrar formularios
  DELETE FROM formularios_formularios_index_version fiv
  WHERE fiv.id_formulario IN (SELECT form_id FROM _del_forms);
  GET DIAGNOSTICS v_deleted_fiv = ROW_COUNT;

  DELETE FROM formularios_formulario f
  WHERE f.id IN (SELECT form_id FROM _del_forms);
  GET DIAGNOSTICS v_deleted_forms = ROW_COUNT;

  -- 7) Borrar versiones de formulario que quedaron huérfanas
  --    Primero identificarlas, luego eliminar sus filas en piv, y al final borrar las versiones.

  CREATE TEMP TABLE _orphan_versions (id_index_version UUID) ON COMMIT DROP;

  INSERT INTO _orphan_versions (id_index_version)
  SELECT v.id_index_version
  FROM formularios_formularioindexversion v
  LEFT JOIN formularios_formularios_index_version fiv
    ON fiv.id_index_version = v.id_index_version
  WHERE fiv.id_index_version IS NULL;

  -- Eliminar primero las referencias en pagina_index_version
  DELETE FROM formularios_pagina_index_version piv
  WHERE piv.id_index_version IN (SELECT id_index_version FROM _orphan_versions);

  -- Ahora sí, eliminar las versiones huérfanas
  DELETE FROM formularios_formularioindexversion v
  WHERE v.id_index_version IN (SELECT id_index_version FROM _orphan_versions);
  GET DIAGNOSTICS v_deleted_versions = ROW_COUNT;


  --------------------------------------------------------------------
  -- Limpieza de huérfanos: páginas / versiones / campos / grupos / fdv
  --------------------------------------------------------------------

  -- PÁGINAS huérfanas: sin ninguna relación en pagina_index_version
  CREATE TEMP TABLE _del_pages (id_pagina UUID) ON COMMIT DROP;
  INSERT INTO _del_pages (id_pagina)
  SELECT p.id_pagina
  FROM formularios_pagina p
  WHERE NOT EXISTS (
    SELECT 1
    FROM formularios_pagina_index_version piv
    WHERE piv.id_pagina = p.id_pagina
  );

  -- Versiones de página pertenecientes a esas páginas huérfanas
  CREATE TEMP TABLE _del_page_versions (id_pagina_version VARCHAR(32)) ON COMMIT DROP;
  INSERT INTO _del_page_versions (id_pagina_version)
  SELECT pv.id_pagina_version
  FROM formularios_pagina_version pv
  WHERE pv.id_pagina IN (SELECT id_pagina FROM _del_pages);

  -- Quitar colocaciones de campos en esas versiones de página
  DELETE FROM formularios_pagina_campo pc
  WHERE pc.id_pagina_version IN (SELECT id_pagina_version FROM _del_page_versions);
  GET DIAGNOSTICS v_deleted_pc = ROW_COUNT;

  -- Eliminar las versiones de página
  DELETE FROM formularios_pagina_version pv
  WHERE pv.id_pagina_version IN (SELECT id_pagina_version FROM _del_page_versions);
  GET DIAGNOSTICS v_deleted_pv = ROW_COUNT;

  -- Eliminar las páginas
  DELETE FROM formularios_pagina p
  WHERE p.id_pagina IN (SELECT id_pagina FROM _del_pages);
  GET DIAGNOSTICS v_deleted_pages = ROW_COUNT;

  -- CAMPOS huérfanos (no usados en ninguna página, ni como grupo, ni como hijo de grupo)
  CREATE TEMP TABLE _del_campos (id_campo UUID) ON COMMIT DROP;
  INSERT INTO _del_campos (id_campo)
  SELECT c.id_campo
  FROM formularios_campo c
  LEFT JOIN formularios_pagina_campo pc ON pc.id_campo = c.id_campo
  LEFT JOIN formularios_campo_grupo  cg ON cg.id_campo = c.id_campo
  LEFT JOIN formularios_grupo       g  ON g.id_campo_group = c.id_campo
  WHERE pc.id_campo IS NULL
    AND cg.id       IS NULL
    AND g.id_grupo  IS NULL;

  -- Valores de dataset asociados a esos campos huérfanos (por si acaso)
  DELETE FROM formularios_fuente_datos_valor fdv
  WHERE fdv.campo_id IN (SELECT id_campo FROM _del_campos);
  GET DIAGNOSTICS v_deleted_fdv = ROW_COUNT;

  -- GRUPOS huérfanos (sin hijos)
  DELETE FROM formularios_grupo g
  WHERE NOT EXISTS (
    SELECT 1 FROM formularios_campo_grupo cg WHERE cg.id_grupo = g.id_grupo
  );
  GET DIAGNOSTICS v_deleted_groups = ROW_COUNT;

  -- Eliminar los campos huérfanos
  DELETE FROM formularios_campo c
  WHERE c.id_campo IN (SELECT id_campo FROM _del_campos);
  GET DIAGNOSTICS v_deleted_campos = ROW_COUNT;

  -- Resumen
  RAISE NOTICE '[purge_forms_of_user] Usuario=%', p_user;
  RAISE NOTICE '  Formularios objetivo: %', (SELECT COUNT(*) FROM _del_forms);
  RAISE NOTICE '  Entradas borradas: %', v_deleted_entries;
  RAISE NOTICE '  Asignaciones borradas: %', v_deleted_assocs;
  RAISE NOTICE '  pagina_index_version borradas: %', v_deleted_piv;
  RAISE NOTICE '  form<->version borradas: %', v_deleted_fiv;
  RAISE NOTICE '  Formularios borrados: %', v_deleted_forms;
  RAISE NOTICE '  Versiones de formulario huérfanas borradas: %', v_deleted_versions;
  RAISE NOTICE '  Colocaciones de campos (pagina_campo) borradas: %', v_deleted_pc;
  RAISE NOTICE '  Versiones de página borradas: %', v_deleted_pv;
  RAISE NOTICE '  Páginas borradas: %', v_deleted_pages;
  RAISE NOTICE '  Valores de dataset (fdv) borrados: %', v_deleted_fdv;
  RAISE NOTICE '  Grupos huérfanos borrados: %', v_deleted_groups;
  RAISE NOTICE '  Campos huérfanos borrados: %', v_deleted_campos;
END;
$$;


ALTER PROCEDURE public.purge_forms_of_user(IN p_user text, IN p_force_shared boolean) OWNER TO santa_ana;

